class CalculadoraFitness ():

    @staticmethod
    def calcular_imc(peso: float, altura: float) -> float: #(Fórmula: peso / (altura^2))
        return peso / (altura * altura)
    @staticmethod
    def clasificar_imc(imc: float) -> str:
        if imc < 18.5:
            return "Bajo peso"
        elif imc >= 25:
            return "Sobrepeso"
        else:
            return "Peso normal"

class Atleta:
    def __init__(self, nombre: str, peso: float, altura: float):
        self.nombre = nombre
        self.peso = peso
        self.altura = altura

    def obtener_reporte(self, incluir_recomendacion: bool = False, **metricas_extra) -> str:
        CalculadoraFitness.calcular_imc(self.peso, self.altura)
        imc = CalculadoraFitness.calcular_imc(self.peso, self.altura)
        lineas = [
            f"Nombre: {self.nombre}",
            f"Peso: {self.peso} kg",
            f"Altura: {self.altura} m",
            f"IMC: {imc}",
        ]

        if metricas_extra:
            lineas.append("\nMétricas Adicionales:")
            for clave in metricas_extra:
                valor = metricas_extra[clave]
                nombre_metrica = clave.capitalize()
                lineas.append(f"{nombre_metrica}: {valor}")

        if incluir_recomendacion:
            lineas.append (f"Recomendacion: ")
            if imc < 18.5:
                lineas.append("Se aconseja aumentar el consumo calórico e hipertrofia.")
            elif imc >= 25:
                lineas.append("Se recomienda deficit calórico moderado y trabajo aeróbico.")
            else:
                lineas.append("Mantener el plan de entrenamiento y nutrición actual.")
        return lineas


atleta = Atleta("Juan", 70.0, 1.75)
reporte = atleta.obtener_reporte(incluir_recomendacion=True)
for linea in reporte:
