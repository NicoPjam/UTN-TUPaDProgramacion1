class Notificador:
    def enviar_recibo(self, cliente : str, total: float) -> None :
        print(f"Se ha enviado el recibo a {cliente} con un total de ${total}")
class ProcesadorDePago:
    def __init__(self, notificador : Notificador) -> None:
        self.notificador = notificador
    def procesar_transaccion(self, cliente : str, items : dict, descuento_cupon : float = 0.0) -> float:
        sub_total = sum(item["precio"] for item in items)
        total = sub_total * (1 - descuento_cupon / 100)
        self.notificador.enviar_recibo(cliente, total)
        return total
    
notificador = Notificador()
procesador = ProcesadorDePago(notificador)
carrito = [{"nombre": "Teclado", "precio": 50.0}, {"nombre": "Mouse", "precio": 30.0}]
procesador.procesar_transaccion("Ana Gómez", carrito, descuento_cupon=10.0)
print ("\n")
